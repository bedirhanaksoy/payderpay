# =====================================================
# PayderPay Environment Template (.env.example)
# Copy to .env and update values for your environment.
# =====================================================

# Environment: Development | Production
ASPNETCORE_ENVIRONMENT=Development

# API host/port
# Development example: http://localhost:5140
# Production example:  http://0.0.0.0:8080
ASPNETCORE_URLS=http://localhost:5140
AllowedHosts=*

# Logging
# Development example: Debug
# Production example:  Information
Logging__LogLevel__Default=Debug
Logging__LogLevel__Microsoft.AspNetCore=Warning

# PostgreSQL
# Development example:
# Host=localhost;Port=5432;Database=payderpay_dev;Username=postgres;Password=postgres
# Production example:
# Host=<prod-host>;Port=5432;Database=payderpay;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=payderpay_dev;Username=postgres;Password=postgres

# External service base URL (debt + payment)
# Development example: http://localhost:5270
# Production example:  https://api.your-vps-domain.com
ExternalServices__MockApiBaseUrl=http://localhost:5270

# SMTP (TODO phase - keep for later)
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__Username=example-user
Smtp__Password=example-password
Smtp__EnableSsl=true
Smtp__FromEmail=noreply@payderpay.com
Smtp__FromName=PayderPay

# Reminder settings (TODO phase - keep for later)
ReminderJob__Enabled=false
ReminderJob__IntervalMinutes=30
ReminderJob__LeadDays=3
